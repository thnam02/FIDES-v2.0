# Copy to .env and fill in. .env is git-ignored. Never commit real keys.
# scripts/demo_up.sh, demo_reset.sh, demo_down.sh and setup_check.sh read this file.

# HMAC-SHA256 key for account hashes. Generate: openssl rand -hex 32
# Every hash in Postgres events and the Redis snapshot depends on it. Change it and you must reload both.
FIDES_HMAC_KEY=

# Shared key between bank-core and the engine (X-API-Key). Generate: openssl rand -hex 32
FIDES_API_KEY=

# Homebrew Postgres 16. Replace YOUR_MAC_USER with the output of: whoami
DATABASE_URL=postgresql://YOUR_MAC_USER@localhost:5432/fides_w1

# Redis db 15 holds the demo feature snapshot.
REDIS_URL=redis://localhost:6379/15
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_CONF=/opt/homebrew/etc/redis.conf

# Ports. The iPhone talks to bank-core only.
ENGINE_PORT=8091
BANK_PORT=8092
