# Copy to bank-app/.env. Metro inlines EXPO_PUBLIC_* at bundle time, so restart Metro after a change.
EXPO_PUBLIC_DEMO_MODE=1
# This Mac's Wi-Fi address (ipconfig getifaddr en0) and the bank-core port. The phone never calls the engine.
EXPO_PUBLIC_BANK_URL=http://YOUR_MAC_LAN_IP:8092
# Same value as BANK_API_KEY in the root .env, or empty when that is empty. It is bundled into the app:
# it keeps other devices on the Wi-Fi out, it is not a secret from whoever holds the app.
EXPO_PUBLIC_BANK_API_KEY=
